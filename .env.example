# ============================================================================
# CaptionForge environment
# Copy to `.env.local` (Next.js app) and set the worker's own env on your host.
# The app runs in DEMO MODE with local mock data if these are omitted.
# ============================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server + worker only, NEVER expose

# ---------- Cloudinary (video upload & delivery) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- OpenAI (Whisper transcription + translation) ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------- Translation provider ('openai' | 'gemini') ----------
TRANSLATION_PROVIDER=openai
GEMINI_API_KEY=your-gemini-key

# ---------- Stripe (international subscriptions) ----------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---------- Razorpay (India subscriptions) ----------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_STARTER=plan_...
RAZORPAY_PLAN_PRO=plan_...
RAZORPAY_PLAN_BUSINESS=plan_...

# ---------- Email (render notifications, via Resend) ----------
RESEND_API_KEY=re_...

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Worker only ----------
POLL_INTERVAL_MS=4000
